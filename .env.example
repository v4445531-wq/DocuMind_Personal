# Copy to .env at the repo root and fill in your keys.
# NEVER commit the real .env.
#
# Quickstart:
#   cp .env.example .env
#   # fill in at least one LLM provider key + EXA_API_KEY for web fallback
#   docker compose up --build
#   open http://localhost:5173  (login: demo / demo12345)

# ============================================================
#  LLM PROVIDER — one line to switch between providers.
#  Set LLM_PROVIDER to:  openai | anthropic | ollama
#  Everything else (model, embedding, dimensions, collection) is derived.
# ============================================================
LLM_PROVIDER=openai

# -- OpenAI (default, highest quality) --
OPENAI_API_KEY=sk-replace-me

# -- Anthropic Claude (chat only; embeddings still use OpenAI) --
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-replace-me

# -- Ollama (FREE / offline, no key needed) --
# LLM_PROVIDER=ollama
# Run:  docker compose --profile ollama up -d ollama
#       docker compose exec ollama ollama pull llama3.2:3b
#       docker compose exec ollama ollama pull nomic-embed-text

# ============================================================
#  SPONSOR INTEGRATIONS
# ============================================================

# -- Exa web search fallback (sponsor: exa.ai) --
# When set, DocuMind falls back to Exa web search on refusals so users get
# useful web context even when their documents don't have the answer.
# Free $50 credits for hackathon participants at exa.ai
EXA_API_KEY=replace-me

# -- Neon serverless Postgres (sponsor: neon.tech) --
# Replace local Postgres with Neon by setting DATABASE_URL.
# Free tier at neon.tech — connection string looks like:
#   postgresql://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require
# Leave blank to use the local Postgres container instead.
DATABASE_URL=

# ============================================================
#  GATEWAY / AUTH
# ============================================================
JWT_SECRET=dev-secret-change-me
DEMO_USERNAME=demo
DEMO_PASSWORD=demo12345
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173

# ============================================================
#  RETRIEVAL TUNING (safe to leave as defaults)
# ============================================================
HYBRID_ENABLED=true
RERANKER=none           # none | llm (no torch) | cross-encoder (needs torch image)
MAX_DISTANCE=0.55       # relevance gate — lower = stricter. Calibrate vs your corpus.
REWRITE_ENABLED=true    # condense follow-up questions into standalone retrieval queries
HISTORY_TURNS=4         # conversation turns replayed into each prompt

# ============================================================
#  OPTIONAL: Langfuse LLM observability
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ============================================================
#  FRONTEND
# ============================================================
VITE_API_BASE_URL=http://localhost:8080
